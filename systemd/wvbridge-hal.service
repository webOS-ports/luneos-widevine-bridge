[Unit]
Description=Widevine bridge: HAL with the oemcrypto spin shim
# Written only when libs-up.sh found the system it was installed on.
ConditionPathExists=/run/wvbridge/env
After=android-system.service wvbridge-libs.service
Wants=wvbridged.service
Before=wvbridged.service
# After this many failures the service stays down with Android's own HAL back.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/var/lib/widevine/bridge/hal-pre.sh
ExecStart=/usr/bin/lxc-attach -n android -- /system/bin/sh -c 'unset LD_LIBRARY_PATH; exec ${WV_LAUNCH}'
ExecStartPost=-/bin/sh -c 'sleep 2; exec /bin/systemctl --no-block try-restart wvbridged.service'
ExecStopPost=-/var/lib/widevine/bridge/hal-post.sh
EnvironmentFile=/run/wvbridge/android
Restart=always
RestartSec=2
TimeoutStartSec=150
