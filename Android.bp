// The Android half of the bridge, built into a Halium GSI. android/build.sh
// builds the same three with the NDK, for a GSI that does not carry them.
// Nothing starts them from Android's init: LuneOS runs them in the container
// from its own services (systemd/), only when the bridge is on, and puts the
// vendor's HAL back when they fail.
//
// 64-bit only: the shim is preloaded into the vendor's Widevine HAL, which is a
// 64-bit process on the devices the bridge supports.

package {
    default_applicable_licenses: ["luneos_widevine_bridge_license"],
}

license {
    name: "luneos_widevine_bridge_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_defaults {
    name: "wvbridge_defaults",
    compile_multilib: "first",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "wvbridged",
    defaults: ["wvbridge_defaults"],
    srcs: ["android/wvbridged.c"],
    local_include_dirs: ["."],
    shared_libs: ["libmediandk"],
}

// 2 ms: the shortest sleep that took the spinning thread's CPU down with no
// late frames in the tests (as in android/build.sh).
cc_library_shared {
    name: "libwvshim",
    defaults: ["wvbridge_defaults"],
    srcs: ["android/wvshim.c"],
    cflags: ["-DSLEEP_NS=2000000"],
    shared_libs: ["libdl"],
}

// The shim goes by name, not path: the HAL is a vendor process, and Halium's
// linkerconfig links libwvshim.so from the system namespace into the vendor
// one, which a full /system path would not match.
cc_binary {
    name: "wvlaunch",
    defaults: ["wvbridge_defaults"],
    srcs: ["android/wvlaunch.c"],
    cflags: ["-DWV_SHIM=\"libwvshim.so\""],
    required: ["libwvshim"],
}
